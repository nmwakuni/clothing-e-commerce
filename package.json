{
  "name": "saas-innovation-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for innovative SaaS platforms targeting Africa",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive type-check",
    "clean": "pnpm --recursive exec rm -rf node_modules dist .next .turbo",
    "dev:lms": "pnpm --filter \"./lms-platform/**\" dev",
    "dev:biashara": "pnpm --filter \"./whatsapp-commerce/**\" dev",
    "dev:mteja": "pnpm --filter \"./mteja/**\" dev",
    "build:lms": "pnpm --filter \"./lms-platform/**\" build",
    "build:biashara": "pnpm --filter \"./whatsapp-commerce/**\" build",
    "build:mteja": "pnpm --filter \"./mteja/**\" build"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
