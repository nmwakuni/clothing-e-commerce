# ==========================================
# SkillHub Africa - API Environment Variables
# ==========================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-xxxxx.us-east-2.aws.neon.tech/skillhub?sslmode=require

# Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production

# AI Services
ANTHROPIC_API_KEY=sk-ant-api03-xxx
OPENAI_API_KEY=sk-xxx

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxx
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=skillhub_verify_token_change_this

# M-Pesa (Safaricom Daraja API)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_ENVIRONMENT=sandbox # or 'production'
MPESA_SHORTCODE=174379 # Paybill/Till number
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-api.com/api/payments/mpesa/callback

# Server Configuration
PORT=8787
NODE_ENV=development

# Cloudflare Workers (for production deployment)
# These are set in wrangler.toml or Cloudflare dashboard
