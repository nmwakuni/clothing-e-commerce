# ==========================================
# SkillHub Africa - Web App Environment Variables
# ==========================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-xxxxx.us-east-2.aws.neon.tech/skillhub?sslmode=require

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production

# WhatsApp Business API
NEXT_PUBLIC_WHATSAPP_NUMBER=254712345678

# Feature Flags
NEXT_PUBLIC_ENABLE_WHATSAPP=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=skillhub.africa

# Error Tracking (Optional)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
